<UserControl x:Class="lab4_5.Controls.StockBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid>
        <Border x:Name="BadgeBorder"
                CornerRadius="10"
                Background="{DynamicResource BrushPanel}"
                BorderBrush="{DynamicResource BrushAccent}"
                BorderThickness="1"
                Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="12" Height="12" Margin="0,0,6,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource BrushSuccess}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Quantity, ElementName=Root}" Value="0">
                                    <Setter Property="Fill" Value="{DynamicResource BrushDanger}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Quantity, ElementName=Root}" Value="1">
                                    <Setter Property="Fill" Value="{DynamicResource BrushWarning}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Quantity, ElementName=Root}" Value="2">
                                    <Setter Property="Fill" Value="{DynamicResource BrushWarning}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Quantity, ElementName=Root}" Value="3">
                                    <Setter Property="Fill" Value="{DynamicResource BrushWarning}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding LabelText, ElementName=Root}" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
