<UserControl x:Class="lab4_5.Controls.DiscountBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             MinHeight="44">
    <StackPanel>
        <Border Height="{Binding BarHeight, ElementName=Root}" CornerRadius="4"
                BorderBrush="{DynamicResource BrushGridBorder}" BorderThickness="1"
                Background="{DynamicResource BrushPanel}">
            <Grid x:Name="BarGrid">
                <Rectangle x:Name="FillRect" HorizontalAlignment="Left" Fill="{DynamicResource BrushAccent}" RadiusX="3" RadiusY="3"/>
            </Grid>
        </Border>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Slider x:Name="DiscountSlider" Width="120" Minimum="0" Maximum="100" ValueChanged="OnSliderValueChanged"/>
            <TextBlock x:Name="PercentText" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock x:Name="DirectText" FontSize="11" Margin="0,4,0,0" Visibility="Collapsed"/>
    </StackPanel>
</UserControl>
