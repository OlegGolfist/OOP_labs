<UserControl x:Class="lab4_5.Controls.RatingStarsPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             MinHeight="36">
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <Button x:Name="Star0" Tag="1" Click="OnStarClick" Width="30" Height="30" Margin="0,0,2,0" Padding="0" Content="★"/>
            <Button x:Name="Star1" Tag="2" Click="OnStarClick" Width="30" Height="30" Margin="0,0,2,0" Padding="0" Content="★"/>
            <Button x:Name="Star2" Tag="3" Click="OnStarClick" Width="30" Height="30" Margin="0,0,2,0" Padding="0" Content="★"/>
            <Button x:Name="Star3" Tag="4" Click="OnStarClick" Width="30" Height="30" Margin="0,0,2,0" Padding="0" Content="★"/>
            <Button x:Name="Star4" Tag="5" Click="OnStarClick" Width="30" Height="30" Margin="0,0,2,0" Padding="0" Content="★"/>
        </StackPanel>
        <TextBlock x:Name="DirectText" FontSize="11" Margin="0,4,0,0" Visibility="Collapsed"/>
    </StackPanel>
</UserControl>
