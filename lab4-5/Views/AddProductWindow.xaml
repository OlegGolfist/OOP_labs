<Window x:Class="lab4_5.Views.AddProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource WinAddTitle}"
        Height="520" Width="420"
        MinHeight="400" MinWidth="360"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/app.ico">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource BtnOk}"
                    Command="{Binding OkCmd, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button Content="{DynamicResource BtnCancel}" IsCancel="True"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="FieldsPanel">
                <Label Content="{DynamicResource ColShort}" Target="{Binding ElementName=TbShort}"/>
                <TextBox x:Name="TbShort" Text="{Binding ShortName, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="{DynamicResource LblFull}" Target="{Binding ElementName=TbFull}"/>
                <TextBox x:Name="TbFull" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="{DynamicResource LblDesc}" Target="{Binding ElementName=TbDesc}"/>
                <TextBox x:Name="TbDesc" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
                <Label Content="{DynamicResource CategoryLabel}" Target="{Binding ElementName=TbCat}"/>
                <TextBox x:Name="TbCat" Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="{DynamicResource ColPrice}" Target="{Binding ElementName=TbPrice}"/>
                <TextBox x:Name="TbPrice" Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="{DynamicResource ColQty}" Target="{Binding ElementName=TbQty}"/>
                <TextBox x:Name="TbQty" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="{DynamicResource LblRating}" Target="{Binding ElementName=TbRating}"/>
                <TextBox x:Name="TbRating" Text="{Binding Rating, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="{DynamicResource LblDiscount}" Target="{Binding ElementName=TbDisc}"/>
                <TextBox x:Name="TbDisc" Text="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="{DynamicResource LblColor}" Target="{Binding ElementName=TbColor}"/>
                <TextBox x:Name="TbColor" Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="{DynamicResource LblSize}" Target="{Binding ElementName=TbSize}"/>
                <TextBox x:Name="TbSize" Text="{Binding Size, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="{DynamicResource LblCountry}" Target="{Binding ElementName=TbCountry}"/>
                <TextBox x:Name="TbCountry" Text="{Binding DeliveryCountry, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="{DynamicResource LblMaker}" Target="{Binding ElementName=TbMaker}"/>
                <TextBox x:Name="TbMaker" Text="{Binding Manufacturer, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="{DynamicResource LblBought}" Target="{Binding ElementName=TbBought}"/>
                <TextBox x:Name="TbBought" Text="{Binding PurchasedCount, UpdateSourceTrigger=PropertyChanged}"/>
                <CheckBox Content="{DynamicResource LblOut}" IsChecked="{Binding IsOutOfStock, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
