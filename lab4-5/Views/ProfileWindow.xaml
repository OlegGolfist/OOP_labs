<Window x:Class="lab4_5.Views.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ProfileTitle}"
        Width="460"
        Height="430"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/app.ico">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <GroupBox Header="{DynamicResource ProfileTitle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Label Content="{DynamicResource ProfileName}"/>
                    <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/>
                    <Label Content="{DynamicResource ProfileEmail}"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                    <Label Content="{DynamicResource MenuLang}"/>
                    <ComboBox SelectedValue="{Binding PreferredLanguage, Mode=TwoWay}" SelectedValuePath="Tag">
                        <ComboBoxItem Content="{DynamicResource MenuLangRu}" Tag="ru"/>
                        <ComboBoxItem Content="{DynamicResource MenuLangEn}" Tag="en"/>
                    </ComboBox>
                    <Label Content="{DynamicResource MenuTheme}"/>
                    <ComboBox SelectedValue="{Binding SelectedTheme, Mode=TwoWay}" SelectedValuePath="Tag">
                        <ComboBoxItem Content="{DynamicResource ThemeOptimistic}" Tag="optimistic"/>
                        <ComboBoxItem Content="{DynamicResource ThemePink}" Tag="pink"/>
                        <ComboBoxItem Content="{DynamicResource ThemeGray}" Tag="gray"/>
                    </ComboBox>
                </StackPanel>
            </ScrollViewer>
        </GroupBox>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{DynamicResource BtnClose}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
